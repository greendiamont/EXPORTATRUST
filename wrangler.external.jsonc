{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exportatrust-external",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "name": "exportatrust-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "exportatrust-staging-db-v2",
          "database_id": "c3ca15f4-4a40-477f-8ee8-7913591c7d29",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "exportatrust-staging-files"
        }
      ]
    },
    "production": {
      "name": "exportatrust-production",
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET"
        }
      ]
    }
  }
}
