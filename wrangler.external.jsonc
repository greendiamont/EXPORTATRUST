{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exportatrust-external",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "name": "exportatrust-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "exportatrust-staging-db-v3",
          "database_id": "9c619b55-0cfc-4ed0-bdd6-4ed51c116c6d",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "exportatrust-staging-files"
        }
      ]
    },
    "production": {
      "name": "exportatrust-production",
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET"
        }
      ]
    }
  }
}
